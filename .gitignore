# Dependencies
node_modules/

# Build output — regenerated by `npm run build`; dev reads straight from src.
# (shared/package.json "main" points at src/index.ts, so shared/dist is never
# loaded at runtime and only causes confusion if committed.)
dist/
shared/dist/
server/dist/
client/dist/

# Local secrets (TURN_SECRET etc.) — see .env.example. Never commit the real .env.
.env

# Misc
.DS_Store
*.log

# Coverage reports (npm run test:coverage)
coverage/

*.tsbuildinfo
