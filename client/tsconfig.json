{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["vite/client"],
    "paths": {
      "shared": ["../shared/src/index.ts"],
      "@sim/*": ["../server/src/*"]
    }
  },
  "include": ["src", "../server/src"]
}
