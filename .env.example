# Copy to `.env` (gitignored) beside docker-compose.yml.

# The public hostname clients dial for TURN/STUN. Must resolve to this host's public IP
# and have UDP 3478 + TCP 3478 + UDP 49160-49200 open to it. Also drives the /api/ice
# origin gate: by default only https://<this host> may mint TURN credentials.
TURN_HOST=game.dev.snowskeleton.net

# OPTIONAL. Leave empty and the origin gate uses https://<TURN_HOST> (the common case).
# Set only to override — a page served from a different origin, or several (comma-sep):
# ALLOWED_ORIGINS=https://game.example.net,https://staging.example.net
ALLOWED_ORIGINS=
