# Copy to `.env` (gitignored) beside docker-compose.yml. The TURN relay is part of the
# default stack now, so TURN_SECRET is REQUIRED — coturn aborts at startup without it.

# A long random shared secret. The server derives short-lived TURN credentials from it
# and coturn verifies them with the same value — so BOTH must see the identical string.
# After copying this file to .env, fill the secret in place with (portable BSD+GNU sed):
#   S=$(openssl rand -hex 32); sed -i.bak "s|^TURN_SECRET=.*|TURN_SECRET=$S|" .env && rm .env.bak
TURN_SECRET=

# The public hostname clients dial for TURN/STUN. Must resolve to this host's public IP
# and have UDP 3478 + TCP 3478 + UDP 49160-49200 open to it.
TURN_HOST=game.dev.snowskeleton.net

# Comma-separated web origins allowed to mint TURN credentials at /api/ice. Leave empty
# to allow any caller (fine for local dev). In production set it to your page's origin so
# other sites' pages and plain curl can't pull credentials:
# ALLOWED_ORIGINS=https://game.dev.snowskeleton.net
ALLOWED_ORIGINS=
